{
  "name": "ivanilsonsousa/agnostic-pdf",
  "description": "Manipulação, assinatura digital e verificação de PDFs com integração opcional para Laravel",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "AgnosticPDF\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.2",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-zlib": "*",
    "dompdf/dompdf": "^3.1",
    "mpdf/mpdf": "^8.2",
    "papier/papier": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.3",
    "friendsofphp/php-cs-fixer": "^3.85",
    "mockery/mockery": "^1.6",
    "orchestra/testbench": "^10.5 || ^11.0",
    "fakerphp/faker": "^1.23"
  },
  "suggest": {
    "laravel/framework": "Required only for the optional Laravel service provider, facade, views and HTTP responses (^12.0 || ^13.0)."
  },
  "extra": {
    "laravel": {
      "providers": [
        "AgnosticPDF\\AgnosticPDFServiceProvider"
      ]
    }
  }
}
